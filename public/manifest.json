{
  "manifest_version": 3,
  "name": "CodeRelay",
  "version": "1.0.0",
  "description": "Automatically sync your LeetCode, GFG, Codeforces, and CodeChef solutions to GitHub.",
  "action": {
    "default_icon": "assets/icon.png",
    "default_popup": "src/popup/popup.html",
    "default_title": "CodeRelay Dashboard"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://geeksforgeeks.org/*",
    "https://*.geeksforgeeks.org/*",
    "https://codechef.com/*",
    "https://*.codechef.com/*",
    "https://codeforces.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://geeksforgeeks.org/*",
        "https://*.geeksforgeeks.org/*",
        "https://codechef.com/*",
        "https://*.codechef.com/*",
        "https://codeforces.com/*"
      ],
      "js": [
        "js/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://geeksforgeeks.org/*",
        "https://*.geeksforgeeks.org/*",
        "https://codechef.com/*",
        "https://*.codechef.com/*",
        "https://codeforces.com/*"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/interceptor.js"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://geeksforgeeks.org/*",
        "https://*.geeksforgeeks.org/*",
        "https://codechef.com/*",
        "https://*.codechef.com/*",
        "https://codeforces.com/*"
      ]
    }
  ]
}
 